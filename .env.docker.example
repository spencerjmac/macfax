# Docker Environment Variables
# Copy this to .env.docker and update with your actual values
# .env.docker is gitignored and should never be committed

# Django Backend
SECRET_KEY=change-me-to-a-secure-random-string
DEBUG=False
ALLOWED_HOSTS=*

# Database
DATABASE_URL=postgres://cbb_user:cbb_password@db:5432/cbb_analytics

# Public Domain
PUBLIC_DOMAIN=macfax.usu.edu

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:7001,http://macfax.usu.edu,https://macfax.usu.edu

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:7000,http://localhost:7001,http://macfax.usu.edu,https://macfax.usu.edu

# Docker Internal API URL (IP-based for hostname resolution issues)
API_INTERNAL_URL=http://172.27.1.4:7001

# Next.js Public API Base URL
NEXT_PUBLIC_API_BASE_URL=https://macfax.usu.edu

# Optional: Revalidation secret
# REVALIDATE_SECRET=generate-with-openssl-rand-base64-32
