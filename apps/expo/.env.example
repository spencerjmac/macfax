# Copy to .env to override. Expo does not load .env.example.
# EXPO_PUBLIC_ values are embedded in the JS bundle: never put secrets here.
# When unset, src/lib/api.ts falls back to https://macfax.usu.edu.
# For web dev against local Django, prefer an inline shell variable:
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8000 npx expo start --web
EXPO_PUBLIC_API_BASE_URL=https://macfax.usu.edu
